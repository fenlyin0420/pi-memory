{
	"name": "@fenlyin/pi-memory",
	"version": "0.2.0",
	"description": "Pi extension. A durable memory layer that survives compaction and sessions: markdown store, MEMORY.md catalog in the system prompt, relevant memories recalled per request, new facts extracted after each run.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"memory"
	],
	"type": "module",
	"license": "MIT",
	"author": "fenlyin",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fenlyin0420/pi-memory.git"
	},
	"homepage": "https://github.com/fenlyin0420/pi-memory#readme",
	"bugs": {
		"url": "https://github.com/fenlyin0420/pi-memory/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"check": "npm run typecheck && npm run lint && npm test",
		"smoke": "node scripts/smoke.mjs",
		"migrate": "node scripts/migrate-frontmatter.mjs"
	},
	"files": [
		"src/",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@earendil-works/pi-agent-core": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "22.20.1",
		"typebox": "1.3.6",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	}
}
